{
  "name": "qmediasync",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "pnpm run type-check && pnpm run build-only",
    "lint": "eslint \"./{src,test}/**/*.{js,jsx,mjs,ts,tsx,vue}\"",
    "lint:fix": "eslint \"./{src,test}/**/*.{js,jsx,mjs,ts,tsx,vue}\" --fix",
    "build-only": "vite build --mode=production --emptyOutDir --outDir dist",
    "check:build": "node test/regression/charts-chunk-cycle.check.mjs",
    "dev": "vite",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "github-markdown-css": "^5.9.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "type": "module"
}
